# The cube program that runs once it is online. Starts only when the cube has a WiFi connection at
# boot; otherwise kuv-setup.service runs first and starts this one when it is done.
# It draws through kuv-matrix.service.
[Unit]
Description=Kuv cube
After=network-online.target NetworkManager.service kuv-matrix.service
Wants=network-online.target kuv-matrix.service

[Service]
WorkingDirectory=/home/luna/kuv/kuv-cube
# All the settings of the cube (server, secret, id...), see deploy/kuv.env.example.
EnvironmentFile=-/etc/kuv/kuv.env
ExecCondition=/bin/sh -c 'nmcli -t -g STATE general | grep -q "^connected"'
# Setup is done once the cube is online, so let it go before main starts.
ExecStartPre=-/usr/bin/systemctl stop kuv-setup.service
ExecStart=/home/luna/kuv/venv/bin/python -m programs.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
