# Kü-V cube: ALL the settings of the Raspberry Pi, in one file.
#
# Install it as /etc/kuv/kuv.env (owner root, mode 600: it holds secrets, never commit the real one):
#   sudo mkdir -p /etc/kuv && sudo cp deploy/kuv.env.example /etc/kuv/kuv.env
#   sudo chmod 600 /etc/kuv/kuv.env && sudo nano /etc/kuv/kuv.env
# Every kuv-*.service reads it through EnvironmentFile=. After editing it, restart what uses it
# (the "Used by" line of each setting), e.g. `sudo systemctl restart kuv-cube.service`.
#
# Format rules (systemd): KEY=value, one per line, no quotes needed, no spaces around "=".
# Comments must be on their own line: a "#" after a value would become part of the value.
# A line that starts with "#" is a setting that is off: remove the "#" to use it.

# ----------------------------------------------------------------------------------------------
# Live link to the server (programs/main/link/). Without URL and secret the cube still works,
# it just does not receive commands from the server.
# ----------------------------------------------------------------------------------------------

# Address of the kuv-api server, WebSocket scheme (ws:// or wss://), no path.
# Used by: kuv-cube.service
KUV_SERVER_URL=ws://192.168.1.20:5038

# Secret the server expects from cubes. Must be the same value as Cubes__Secret in kuv-api.
# Used by: kuv-cube.service
KUV_CUBE_SECRET=change-me

# The id of this cube: what the user types in the web app to talk to it.
# Optional. By default it is the machine id (cat /etc/machine-id); set it to choose a friendlier one.
# Used by: kuv-cube.service
#KUV_CUBE_ID=my-cube

# ----------------------------------------------------------------------------------------------
# Setup over Bluetooth (programs/setup/). Runs only while the cube is offline.
# ----------------------------------------------------------------------------------------------

# The PIN the web app must send before it may change the WiFi. By default one of 4 digits is
# generated on the first run and remembered in KUV_STATE_DIR/setup-pin (read it with
# `sudo cat /var/lib/kuv/setup-pin`). Set it here to choose your own; set it to an empty value
# (KUV_SETUP_PIN=) to turn the PIN off.
# Used by: kuv-setup.service
#KUV_SETUP_PIN=1234

# Folder where the cube remembers things between boots (today: the generated PIN).
# Default: /var/lib/kuv
# Used by: kuv-setup.service
#KUV_STATE_DIR=/var/lib/kuv

# 1 = keep the setup program running even after the cube is online (for developing the setup
# page); by default it hands over to kuv-cube.service when the cube gets WiFi.
# Used by: kuv-setup.service
#KUV_SETUP_STAY=1

# 1 = require Bluetooth pairing before a page can talk to the cube (encrypts the link).
# Default: off.
# Used by: kuv-setup.service
#KUV_SETUP_PAIRING=1

# ----------------------------------------------------------------------------------------------
# LED panels (programs/matrix/)
# ----------------------------------------------------------------------------------------------

# Folder with the BDF fonts of the matrix library, used to draw the PIN.
# Default: /home/luna/rpi-rgb-led-matrix/fonts
# Used by: kuv-matrix.service
#KUV_FONT_DIR=/home/luna/rpi-rgb-led-matrix/fonts

# ----------------------------------------------------------------------------------------------
# Discord alerts (boot, shutdown and code updates)
# ----------------------------------------------------------------------------------------------

# Webhook for the boot message and the "code updated" message.
# Used by: kuv-discord-boot.service, kuv-update.service
DISCORD_WEBHOOK_URL=

# Webhook for the shutdown message.
# Used by: kuv-discord-shutdown.service
DISCORD_WEBHOOK_SHUTDOWN_URL=
